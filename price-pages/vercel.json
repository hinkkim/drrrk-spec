{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": [
    "SPA 레포 루트의 vercel.json 에 병합해서 쓰는 예시입니다.",
    "Vercel 라우팅 순서는 headers/redirects → 파일시스템 → rewrites 이므로,",
    "/price/*.html 실제 파일이 존재하면 아래 SPA catch-all 보다 먼저 서빙됩니다.",
    "그래도 의도를 명시해두는 편이 안전해서 catch-all 에서 price 를 제외했습니다."
  ],

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/((?!price/|sitemap-price\\.xml|robots\\.txt|assets/).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/price/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
